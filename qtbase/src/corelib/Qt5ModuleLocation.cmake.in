if("@QT_BUILDING_SUPERPROJECT@" STREQUAL "ON")
    get_filename_component(_qt5_root_dir
        "${CMAKE_CURRENT_LIST_DIR}/../../../.."
        ABSOLUTE
    )

    file(GLOB qtmodules
        "${_qt5_root_dir}"
        "${_qt5_root_dir}/*"
    )

    foreach(qtmodule IN LISTS qtmodules)
        if(IS_DIRECTORY "${qtmodule}")
            list(APPEND _qt5_module_paths
                "${qtmodule}"
                "${qtmodule}/lib/cmake"
            )
        endif()
    endforeach()
else()
    set(_qt5_root_dir "${_qt5_install_prefix}")
    set(_qt5_module_paths "${_qt5_install_prefix}")
endif()

set(_qt5_module_location_template "${_qt5_root_dir}")
